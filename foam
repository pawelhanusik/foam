#!/usr/bin/env bash
# foam: run a command (default: interactive shell) in a sandbox that sees
# only the network, the current directory (read-write) and a read-only
# system (/usr, /etc). Works on the host and inside distrobox/toolbox.
# Every invocation is an independent sandbox, so you can run it many times.
#
# Profiles: each profile has its own persistent $HOME, so tools in
# different profiles can't read each other's configs or tokens.
#   home:   ~/.local/share/foam/<profile>/home
#   config: ~/.config/foam/<profile>.sh  (optional, sourced on the host)
#
# Usage: foam [-p PROFILE] [-t] [--] [COMMAND [ARGS...]]
#   foam                     # interactive shell, profile "default"
#   foam make test           # run a command
#   foam bash -c 'a | b'     # shell syntax
#   foam -p node npm install # run in profile "node"
#   FOAM_PROFILE=node foam   # same as -p node
#   foam -t                  # throwaway $HOME, nothing persists
#   FOAM_DEBUG=1 foam        # print the bwrap command line
set -euo pipefail

die() { echo "foam: $*" >&2; exit 1; }
usage() { sed -n '/^#!/d; /^#/!q; s/^# \{0,1\}//p' "$0"; }

profile=${FOAM_PROFILE:-default}
tmp_home=
while getopts ':p:th' opt; do
  case $opt in
    p) profile=$OPTARG ;;
    t) tmp_home=1 ;;
    h) usage; exit 0 ;;
    :) die "-$OPTARG needs an argument" ;;
    *) die "unknown option -$OPTARG (try -h)" ;;
  esac
done
shift "$((OPTIND - 1))"

# No dots or slashes, so a profile name can't escape the data directory
[[ $profile =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid profile name: $profile"

command -v bwrap >/dev/null || die "bwrap not found, install the 'bubblewrap' package"

work=$(pwd -P)
home=$(realpath "$HOME")
sandbox_home=${XDG_DATA_HOME:-$HOME/.local/share}/foam/$profile/home
conf=${XDG_CONFIG_HOME:-$HOME/.config}/foam/$profile.sh

# Don't accidentally expose your whole home (or anything above it)
[[ "$work" == "/" ]] && die "refusing to expose /"
[[ "$work" == "$home" ]] && die "refusing to expose $work (it's your home directory)"
case "$home/" in
  "$work"/*) die "refusing to expose $work (it contains your home directory)" ;;
esac

args=(
  --die-with-parent
  --unshare-all --share-net      # new user/pid/ipc/uts/cgroup ns, keep network
  --hostname foam
  --clearenv
  --ro-bind /usr /usr
  --ro-bind /etc /etc
  --dev /dev
  --proc /proc
  --tmpfs /tmp
  --tmpfs /var/tmp
  --tmpfs /run
)

# Merged-/usr symlinks (/bin -> usr/bin) vs. real dirs on older distros.
# On Fedora Atomic /opt -> var/opt, so bind the real target too.
for d in /bin /sbin /lib /lib32 /lib64 /libx32; do
  [[ -e $d ]] || continue
  if [[ -L $d ]]; then
    args+=(--symlink "$(readlink "$d")" "$d")
    real=$(realpath "$d")
    [[ $real == /usr/* ]] || args+=(--ro-bind "$real" "$real")
  else
    args+=(--ro-bind "$d" "$d")
  fi
done

# Fedora Atomic: /home -> var/home (only the symlink, not other users' homes)
if [[ -L /home ]]; then
  args+=(--symlink "$(readlink /home)" /home)
fi

# resolv.conf is often a symlink into /run (systemd-resolved, NetworkManager)
if [[ -L /etc/resolv.conf ]]; then
  r=$(realpath /etc/resolv.conf)
  if [[ -e $r ]]; then args+=(--ro-bind "$r" "$r"); fi
fi

# Minimal environment (before the profile config, so it can override)
args+=(
  --setenv HOME "$HOME"
  --setenv USER "${USER:-$(id -un)}"
  --setenv LOGNAME "${USER:-$(id -un)}"
  --setenv PATH "$PATH"
  --setenv SHELL /bin/bash
  --setenv FOAM 1
  --setenv FOAM_PROFILE "$profile"
)
for v in TERM COLORTERM LANG LANGUAGE EDITOR VISUAL $(compgen -e | grep '^LC_' || true); do
  if [[ -n ${!v:-} ]]; then args+=(--setenv "$v" "${!v}"); fi
done

# Sandbox $HOME: one persistent home per profile, or a throwaway tmpfs
if [[ -n $tmp_home ]]; then
  args+=(--tmpfs "$home")
else
  mkdir -p "$sandbox_home"
  args+=(--bind "$sandbox_home" "$home")
fi

# Per-profile extras (read-only binds, env, ...). This is trusted code run
# on the host, so it must live somewhere no sandbox can write. Bind paths
# under your home with "$home" (resolved path), not "$HOME".
if [[ -f $conf ]]; then
  # shellcheck source=/dev/null
  source "$conf"
fi

# The one real directory the sandbox can write to (after the profile
# config, so it wins over any read-only bind of a parent directory)
args+=(--bind "$work" "$work" --chdir "$work")

# Block TIOCSTI terminal injection. Newer kernels already block it for
# unprivileged processes; on older ones fall back to --new-session
# (costs job control in interactive shells).
if [[ $(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null || true) != 0 ]]; then
  args+=(--new-session)
fi

if (($#)); then
  cmd=("$@")
else
  # --rcfile replaces ~/.bashrc; our rcfile sources ~/.bashrc itself and
  # sets PS1 last, so no distro or user bashrc can overwrite the prompt
  cmd=(bash --rcfile /run/foam.bashrc -i)
fi

args+=(--ro-bind-data 3 /run/foam.bashrc)

if [[ -n ${FOAM_DEBUG:-} ]]; then
  printf '%q ' bwrap "${args[@]}" -- "${cmd[@]}" >&2; echo >&2
fi

exec bwrap "${args[@]}" -- "${cmd[@]}" 3<<'EOF'
[ -f ~/.bashrc ] && . ~/.bashrc
shopt -s histappend
PS1='🫧[\u@${FOAM_PROFILE} \W]\$ '
EOF
